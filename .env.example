# .env.example
# Copiar a .env.local y completar con valores reales

# Supabase — obtener en: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui

# Cifrado AES-256 para credenciales de redes sociales
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=genera-una-clave-aleatoria-de-minimo-32-caracteres

# Secret para el cron job de publicación
# Generar con: openssl rand -hex 16
CRON_SECRET=genera-otro-secret-para-el-cron
