# .env.example
# Copiar a .env.local y completar con valores reales

# Cifrado AES-256 para credenciales de redes sociales
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=genera-una-clave-aleatoria-de-minimo-32-caracteres

# Firma de las cookies de sesión (si se omite, se usa ENCRYPTION_KEY)
# Generar con: openssl rand -hex 32
SESSION_SECRET=genera-otra-clave-aleatoria

# Secret para el cron job de publicación
# Generar con: openssl rand -hex 16
CRON_SECRET=genera-otro-secret-para-el-cron

# Conexión a PostgreSQL (las tablas se crean solas en el primer arranque)
# Crear la base antes: CREATE DATABASE vaultpost ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL=postgresql://postgres:tu-password@localhost:5432/vaultpost

# URL pública de la app — necesaria SOLO para publicar de verdad en Instagram:
# Meta descarga la imagen desde acá. En local usá un túnel (ngrok/cloudflared).
# PUBLIC_BASE_URL=https://tu-tunel.ngrok-free.app
